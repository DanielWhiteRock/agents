{
  "name": "agents-alphaceo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit --silent && npm run test:integration --silent",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/app/server.js",
    "dev": "tsc -p tsconfig.build.json && node dist/src/app/server.js",
    "test:unit": "vitest run",
    "test:integration": "tsc -p tsconfig.build.json && node --test --test-concurrency=1 tests/node/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}